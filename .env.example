# Optional. AyahLab runs without a .env file: reading, study, writing and
# analysis features all work offline. These values are only needed for
# sign-in and the AI features (chat, take-home messages, text transforms).
#
# To use them, copy this file to .env and fill in the URL and anon key of your
# own Supabase project, which must provide the auth setup and edge functions
# the AI features call.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
