{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AyahLab",
  "version": "1.4.0",
  "identifier": "com.al-ahmadgaidasaad.ayahlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AyahLab (v1.4.0)",
        "width": 1380,
        "height": 800,
        "minWidth": 1250,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; media-src 'self' blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["data/quran_static.db", "data/manuscripts/demo/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lexical"],
        "name": "AyahLab Document",
        "description": "AyahLab Lexical editor file",
        "role": "Editor"
      }
    ]
  }
}
