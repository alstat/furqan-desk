{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AyahLab",
  "version": "0.1.0",
  "identifier": "com.al-ahmadgaidasaad.furqan-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AyahLab",
        "width": 1250,
        "height": 800,
        "minWidth": 1150,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "data/quran-uthmani.sql",
      "data/quranic-corpus-morphology-0.4 2.txt",
      "data/recitation/ayah-recitation-mishari-rashid-al-afasy-murattal-hafs-953.db",
      "data/recitation/ayah-recitation-saad-al-ghamdi-murattal-hafs-954.db"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lexical"],
        "name": "Furqan Desk Document",
        "description": "Furqan Desk Lexical editor file",
        "role": "Editor"
      }
    ]
  }
}
