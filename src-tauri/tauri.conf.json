{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AyahLab",
  "version": "1.0.0",
  "identifier": "com.al-ahmadgaidasaad.ayahlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AyahLab",
        "width": 1250,
        "height": 800,
        "minWidth": 1150,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": [
      "data/quran-uthmani.sql",
      "data/quranic-corpus-morphology-0.4 2.txt",
      "data/recitation/ayah-recitation-mishari-rashid-al-afasy-murattal-hafs-953.db",
      "data/recitation/ayah-recitation-saad-al-ghamdi-murattal-hafs-954.db",
      "data/translation/bn/dr-abu-bakr-muhammad-zakaria-simple.json",
      "data/translation/en/en-haleem-with-footnote-tags.json",
      "data/translation/en/en-sahih-international-with-footnote-tags.json",
      "data/translation/fa/fr-hussein-taji-simple.json",
      "data/translation/ha/abubakar-mahmood-jummi-with-footnote-tags.json",
      "data/translation/hi/maulana-azizul-haque-al-umari-with-footnote-tags.json",
      "data/translation/id/quran-id-with-footnote-tags.json",
      "data/translation/ms/abdullah-basamia-simple.json",
      "data/translation/pa/bayan-ul-quran-simple.json",
      "data/translation/ps/pashto-translation-rowwad-translation-center-simple.json",
      "data/translation/sw/dr-abdullah-muhammad-abu-bakr-and-sheikh-nasir-khamis-simple.json",
      "data/translation/tl/dar-al-salam-center-tagalog-simple.json",
      "data/translation/tr/dar-al-salam-center-simple.json",
      "data/translation/ur/bayan-ul-quran-simple.json",
      "data/translation/ru/quran-ru-kuliev-simple.json",
      "data/tafsir/ar/ar-tafsir-ibn-kathir.json",
      "data/tafsir/ar/ar-tafsir-al-tabari.json",
      "data/tafsir/en/en-tafisr-ibn-kathir.json",
      "data/tafsir/tl/tagalog-Al-Mukhtasar.json",
      "data/transliteration/english-transliteration-tajweed-simple.json",
      "data/word-by-word/english-wbw-translation.json",
      "data/manuscripts/demo/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["lexical"],
        "name": "AyahLab Document",
        "description": "AyahLab Lexical editor file",
        "role": "Editor"
      }
    ]
  }
}
